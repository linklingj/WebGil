# 벤치 하니스(tools/bench)용 LLM 제공자 설정.
# `cp .env.example .env` 후 값을 채운다. `.env`는 gitignore되어 있다.
#
# 확장(apps/extension)은 이 파일을 쓰지 않는다 — 팝업 설정에서 저장하고,
# API 키는 content script에 노출되지 않도록 chrome.storage의 신뢰된 컨텍스트에만 둔다.
#
# 셋 다 채워야 실제 LLM을 호출한다. 하나라도 비면 벤치는 드라이런(한도 측정)만 한다.

# openai | gemini | anthropic
WEBGIL_PROVIDER=anthropic

# 예) anthropic: claude-sonnet-5 · openai: gpt-5 · gemini: gemini-2.5-flash
WEBGIL_MODEL=claude-sonnet-5

WEBGIL_API_KEY=
